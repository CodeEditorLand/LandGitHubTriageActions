{
	"compilerOptions": {
		"baseUrl": "./",
		"lib": [
			"es2020"
		],
		"module": "commonjs",
		"moduleResolution": "node",
		"outDir": "Target",
		"removeComments": false,
		"resolveJsonModule": true,
		"rootDir": "src",
		"skipLibCheck": true,
		"sourceMap": true,
		"strict": true,
		"target": "es2019"
	},
	"exclude": [
		"**/*.test.ts",
		"**/vm-filesystem/**"
	],
	"extends": "@playform/build/tsconfig",
	"include": [
		"src"
	]
}
